# ============================================================================
# Standalone Makefile for saterminal (Incremental Builds)
# ============================================================================

#SDK_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
SDK_DIR := /home/halano/code/plugin-sdk-sa
PREFIX ?= i686-w64-mingw32-
CXX    := $(PREFIX)g++

TARGET := saterminal.SA.asi
SOURCES := main.cpp commands.cpp draw.cpp input.cpp utils.cpp
OBJECTS := $(SOURCES:.cpp=.o)
DEPS    := $(SOURCES:.cpp=.d)

CXXFLAGS := -std=c++23 -O2 -pipe -ffunction-sections -fdata-sections -DNDEBUG -fms-extensions -fpermissive -fcommon \
            -Wno-invalid-offsetof -Wno-microsoft-include \
            -Wno-builtin-macro-redefined -DGTASA -DRW -DPLUGIN_SGV_10US \
            -I$(SDK_DIR)/plugin_sa \
            -I$(SDK_DIR)/plugin_sa/game_sa \
            -I$(SDK_DIR)/plugin_sa/game_sa/enums \
            -I$(SDK_DIR)/plugin_sa/game_sa/rw \
            -I$(SDK_DIR)/shared \
            -I$(SDK_DIR)/shared/game \
            -I$(SDK_DIR)/shared/extender \
            -I$(SDK_DIR)/shared/extensions \
            -I$(SDK_DIR)/shared/comp \
            -I$(SDK_DIR)/hooking \
            -I$(SDK_DIR)/safetyhook \
            -I$(SDK_DIR)/injector \
            -I$(SDK_DIR)/modutils \
            -I$(SDK_DIR)/stb

LDFLAGS := -shared -static -static-libgcc -static-libstdc++ -Wl,--as-needed -Wl,--gc-sections -s
LIB_DIR := $(SDK_DIR)/build/sa/release/lib
LIBS    := -L$(LIB_DIR) -lPlugin -ld3dx9

.PHONY: all clean

all: $(TARGET)

# Link step
$(TARGET): $(OBJECTS)
	@echo "  LD      $@"
	@$(CXX) $(OBJECTS) -o $@ $(LDFLAGS) $(LIBS)
	@file $@

# Compile step (Incremental)
%.o: %.cpp
	@echo "  CXX     $<"
	@$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# Include the dependency files generated by -MMD
-include $(DEPS)

clean:
	@rm -f $(OBJECTS) $(DEPS) $(TARGET)
	@echo "  CLEAN   build artifacts"